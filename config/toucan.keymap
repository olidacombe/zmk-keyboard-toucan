#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define SYMBOLS 1
#define NUMBERS 2
#define NAV 3
#define FUNCTION 4
#define BLUETOOTH 5
#define CLICK 6

#define LCLK 1
#define RCLK 2

// tapping-term-ms
#define TT 160

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <TT>;
            quick-tap-ms = <0>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
        hmpt: homerow_mods_prefer_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_PREFER_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <TT>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
        blt: balanced_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "BALANCED_LAYER_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <TT>;
            quick-tap-ms = <0>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
        };
        tt: toggle_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "TOGGLE_LAYER_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&tog>;
        };
    };

    macros {
        vi_editing_mode: vi_editing_mode {
            label = "vi editing-mode";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp S &kp E &kp T &kp SPACE &kp MINUS &kp O &kp SPACE &kp V &kp I &kp RET>;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_vi_editing_mode {
            timeout-ms = <50>;
            key-positions = <27 28>;
            bindings = <&vi_editing_mode>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
// --------------------------------------------------------------------------------------------------------------------------------------------------------------------
//  '    |  ,  |  .  |  P/Nav  |  Y  |                             |  F/Fn  |  G  |  C/Caps  |    R    |  L   |
// A/Sym |  O/Ctrl  |  E/Alt [A->F13]? |  U/Cmd  |  I  |           |  D  |  H/Cmd  |  T/Alt  |    N/Ctrl    |  S/Sym |
// Esc/Lsft|  Q/Click  |  J  |  K  |  X  |                               |  B  |  M  |  W  |    V    |Z/Rsft|
// | | Bspc/LC | SPC/Num/RC |                                                       | Ent | Tab |     |
           bindings = <
              &none &lt BLUETOOTH APOS &kp COMMA &kp DOT &blt NAV P &kp Y &lt FUNCTION F &kp G &hm CAPS C &kp R  &kp L &none
              &none &blt SYMBOLS A &hm LCTRL O &hmpt LALT E &hm LCMD U &kp I &kp D &hm RCMD H &hmpt LALT T &hm RCTRL N &blt SYMBOLS S &none
              &none &hm LSHFT ESC &blt CLICK Q &kp J &kp K &kp X &kp B &kp M &kp W &blt CLICK V &hm RSHFT Z &none
              &none &kp BSPC &blt NUMBERS SPACE &kp RET &kp TAB &none
            >;
        };

        symbols {
            display-name = "SYM";
// --------------------------------------------------------------------------------------------------------------------------------------------------------------------
//  !  |  @  |  {  |  }  |     |                |         |    <    |    >   |  *  |   #  |
//  ^  |  $  |  (  |  )  |  \  |                |    &    |    =    |    -   |  :  |   ;  |
//  ~  |  `  |  [  |  ]  |     |                |         |    +    |    _   |  %  |   ?  |
//         |  ,,  | |/&  | //\ |                |    "    |    `    |   ,,   |
           bindings = <
             &none &kp EXCL &hm LS(LCTRL) AT &hmpt LS(LALT) LBRC &hm LS(LCMD) RBRC &none &none &hm RS(RCMD) LT &hmpt RS(LALT) GT &hm RS(RCTRL) ASTERISK &hm LA(N3) HASH &none
             &none &kp CARET &hm LCTRL DOLLAR &hmpt LALT LPAR &hm LCMD RPAR &kp BACKSLASH &kp AMPS &hm RCMD EQL &hmpt LALT MINUS &hm RCTRL COLON &kp SEMICOLON &none
             &none &kp TILDE &kp GRAVE &kp LBKT &kp RBKT &none &none &kp PLUS &kp UNDERSCORE &kp PERCENT &kp QMARK &none
             &trans &mt AMPS PIPE &mt BACKSLASH SLASH &kp DQT &kp GRAVE &none
           >;
        };

        numbers {
            display-name = "NUM";
// --------------------------------------------------------------------------------------------------------------------------------------------------------------------
//   s-f5  |  s-f6  |  s-f7 |  s-f8  |   |            |         |    4/<    |    5/>   |  6/*  |   7//  |
//    s-f1   |  s-f2 |  s-f3 | s-f4 |   |             |   DEL   |    0/=    |    1/-   | 2/: |   3/;  |
//     s-f9   | s-f10 | s-f11 | s-f12 |   |           |         |    8/+    |    9/_   | +/- | *//  |
//         |      |     |      |     |      |    .    |    =    |      |
           bindings = <
              &none &kp LS(F5) &kp LS(F6) &kp LS(F7) &kp LS(F8) &none &none &hmpt LT N4 &hmpt GT N5 &hmpt ASTERISK N6 &hmpt SLASH N7 &none
              &none &kp LS(F1) &kp LS(F2) &kp LS(F3) &kp LS(F4) &none &kp DEL &hmpt EQL N0 &hmpt MINUS N1 &hmpt COLON N2 &hmpt SEMICOLON N3 &none
              &none &kp LS(F9) &kp LS(F10) &kp LS(F11) &kp LS(F12) &none &none &hmpt PLUS N8 &hmpt UNDERSCORE N9 &hmpt MINUS PLUS &hmpt SLASH ASTERISK &none
 	          &none &none &none &kp DOT &kp EQL &none
            >;
        };

        nav {
            display-name = "NAV";
// --------------------------------------------------------------------------------------------------------------------------------------------------------------------
//     |     |     |     |     |                |         |         |    ^   |     |      |
//     |     |     |     |     |                |         |    <    |    v   |  >  |      |
//     |     |     |     |     |                |         |   HOME  |        | END |      |
//         |      |     |      |     |      |    PgDN   |   PgUP  |      |
           bindings = <
        	  &none &none &none &none &none &none &none &none &none &kp UP &none &none &none
        	  &none &none &none &none &none &none &none &none &kp LEFT &kp DOWN &kp RIGHT &none &none
        	  &none &none &none &none &none &none &none &none &kp HOME &none &kp END &none &none
              &none &none &none &kp PG_DN &kp PG_UP &none
            >;
        };

        fn {
            display-name = "FN";
// --------------------------------------------------------------------------------------------------------------------------------------------------------------------
//  F5 |  F6 | F7  | F8  |     |                |         |         |        |     |      |
//  F1 |  F2 | F3  | F4  | DEL |                |         |         |        |     |      |
//  F9 | F10 | F11 | F12 |     |                |   ,,    |   ,,    |        |     |      |
//         |      |     |      |     |      |           |         |      |
           bindings = <
              &none &kp F5 &kp F6 &kp F7 &kp F8 &none &none &none &none &none &none &none
              &none &kp F1 &kp F2 &kp F3 &kp F4 &kp DEL &none &none &none &none &none &none
              &none &kp F9 &kp F10 &kp F11 &kp F12 &none &none &none &none &none &none &none
	          &none &none &none &none &none &none
            >;
        };

        bt {
            display-name = "BT";
// --------------------------------------------------------------------------------------------------------------------------------------------------------------------
//     |     |     |     |     |                |         |         |        |     |      |
//     |     |     |     |     |                |   P0    |    P1   |   P2   |  P3 |  P4  |
//     |     |     |     |     |                | BT/USB  |         |        |     |      |
//         | CLR  |     |      |
           bindings = <
              &none &none &none &none &none &none &none &none &none &none &none &none
              &none &none &none &none &none &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none
              &none &none &none &none &none &none &out OUT_TOG &none &none &none &none &none
	          &none &bt BT_CLR &none &none &none &none
            >;
        };

        click {
            bindings = <
              &none &trans     &trans     &trans  &trans     &trans    &trans  &trans  &trans  &trans  &trans &none
              &none &kp LSHFT  &trans     &trans  &trans     &trans    &trans  &trans  &trans  &trans  &trans &none
              &none &kp LCTRL  &trans  &kp LALT  &kp LCMD    &trans    &trans  &trans  &trans  &trans  &trans &none
              &trans  &mkp RCLK &mkp LCLK    &mkp LCLK  &mkp RCLK &trans
            >;
        };

    };
};
